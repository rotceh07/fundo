# Sample requests for the external mock. The SSN below is fictitious test data.
@host = http://localhost:5180
@customerId = 3f2b6c1e-8d4a-4e7b-9c2d-1a5f6e7b8c9d

POST {{host}}/api/customers
Content-Type: application/json

{
  "customerId": "{{customerId}}",
  "applicationId": "9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d",
  "firstName": "Test",
  "lastName": "User",
  "address": "100 Main St",
  "state": "FL",
  "companyName": "Acme",
  "ssn": "000000001",
  "requestedAmount": 10000
}

###

